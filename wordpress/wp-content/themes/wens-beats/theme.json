			"palette": [
				{
					"color": "#090909",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#eeeeee",
					"name": "Contrast",
					"slug": "contrast"
				},
				{
					"color": "#0a6a47",
					"name": "Primary",
					"slug": "primary"
				},
				{
					"color": "#183a1d",
					"name": "Secondary",
					"slug": "secondary"
				},
				{
					"color": "transparent",
					"name": "Transparent",
					"slug": "transparent"
				}
			]
		},
		"layout": {
			"contentSize": "900px",
			"wideSize": "1280px"
		},
		"spacing": {
