		"css": ".wp-element-button:hover,\n.wp-element-button:focus,\n.wpcf7-submit:hover,\n.wp-block-search__button:focus,\n.wp-block-search__button:hover,\n.wp-block-button a:focus,\n.wp-block-button a:hover{\n    background-color: #000 !important;\n    border-color: #000 !important;\n}\n\n.page-numbers.current,\na:focus,\na:hover{\ncolor: var(--wp--preset--color--secondary);\n}\n\n.wc-block-components-product-name{\ncolor: #fff;\n}\n\n.wp-block-query-pagination a,\n.wp-block-comment-date a,\n.wp-block-comment-author-name a,\n.wp-block-navigation-submenu a,\n.wp-block-navigation-link a,\n.wp-block-categories a,\n.wp-block-post-title a,\n.wp-block-site-title a{\n   text-decoration: none !important;\n}\n\n.about-section-image-relative{\n    z-index: 2;\n    position: relative !important;\n}\n\n\n.testimonial-relative-post-content,\n.about-relative-post-content{\nz-index: 2;\n    position: relative !important;\n}\n\n.wpcf7-text{\nwidth: 100%;\nheight: 30px;\n}\n\n.wpcf7-textarea{\nwidth: 100%;\n}\n\ninput.wp-element-button,\n.wpcf7-submit{\n        padding: 10px 30px;\n    background: var(--wp--preset--color--primary) !important;\n    border: none;\n    color: #fff;\nfont-size: 16px;\n}\n\n\n@media only screen and (max-width: 1000px) {\n  .mobile-disable{\n      display:none;\n  }\n}\n\n.woocommerce-account, \n.woocommerce-account .woocommerce-MyAccount-content a,\n.woocommerce-account .woocommerce-MyAccount-content p{\ncolor: #000;\n}\n\n.page-id-340 .designone .wens-haelo-playlist {\n    justify-content: flex-start;\n    width: 130%;\n}\n\n.wens-musico-pro-social-share-wrapper a{\n    display: inline-flex;\n}\n\n.single .taxonomy-post_tag.wp-block-post-terms a {\n    border: 1px solid;\n    border-radius: 2px;\n    padding: 3px 5px;\n    margin: 1px;\n    font-size: 12px !important;\n    text-decoration: none;\n}\n\n.wp-block-post-terms a{\ntext-decoration: none;\n}\n\n.wp-block-button__link:hover{\n    background-color: #000;\n    color: #fff;\n}\n\n#gallery-section img{\n    filter: blur(2px);\n}\n\n#gallery-section img:hover{\n    filter: blur(0px);\n}\n\n.wp-block-post:hover img,\n#playlist-section .image-wrapper:hover img,\n#about-section .image-wrapper:hover img{\n    filter: blur(2px);\n}\n\n\n#service-section .wp-block-column:hover > .wp-block-group > .wp-block-group,\n#event-section .wp-block-column:hover > .wp-block-group,\n#playlist-section .image-wrapper:hover > .wp-block-group,\n#about-section .image-wrapper:hover > .wp-block-group {\n    border-color: var(--wp--preset--color--primary) !important;\n}\n\n\n\n#event-section #event-date{\n    margin-left: -23px !important;\n    position: absolute;\n    margin-bottom: 66px;\n}\n\n#playlist-section .wens-haelo-audio-player{\n    background-color: #1e1e1e9e !important;\n}\n\n#playlist-section .right-controllers,\n#playlist .wens-haelo-seek-bar,\n#playlist-section .audio-title{\n    display: none;\n}\n\n.wens-haelo-audio-player-wrapper.true {\n    position: fixed !important;\n    bottom: 20px;\n    left: 5%;\n    width: 90%;\n    z-index: 999;\n}\n\n@media (min-width: 601px) {\n#playlist-section .image-wrapper > .wp-block-group,\n    #about-section .image-wrapper > .wp-block-group{\n        width: 90%;\n        padding-left: 50px;\n    }\n\n#playlist-section .image-wrapper > .wp-block-group .wp-block-cover,\n    #about-section .image-wrapper > .wp-block-group .wp-block-cover{\n        width: 120%;\n        margin-top: 50px !important;\n        margin-bottom: -80px !important;\n    }\n\n#playlist-section #section-title,\n    #about-section #section-title{\n        margin-left: -150px;\n    }\n}",
		"elements": {
